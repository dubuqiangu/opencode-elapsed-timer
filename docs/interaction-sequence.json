{"schema_version": 1, "diagram_type": "sequence", "meta": {"title": "elapsed-timer 插件交互时序", "locale": "zh-CN", "output": "docs/interaction-sequence.html", "viewBox": [1040, 620], "column_fit": "spread", "quality_profile": "showcase"}, "participants": [{"id": "user", "type": "external", "label": "用户", "sublabel": "提交 prompt"}, {"id": "tui", "type": "frontend", "label": "OpenCode TUI", "sublabel": "footer 状态行"}, {"id": "plugin", "type": "backend", "label": "elapsed-timer", "sublabel": "计时 + tok/s"}, {"id": "server", "type": "messagebus", "label": "事件总线", "sublabel": "session.* 事件"}, {"id": "provider", "type": "cloud", "label": "AI Provider", "sublabel": "流式输出"}], "segments": [{"from": 150, "to": 282, "label": "启动轮次"}, {"from": 294, "to": 420, "label": "流式计量"}, {"from": 430, "to": 570, "label": "渲染与结算"}], "messages": [{"from": "user", "to": "tui", "y": 180, "label": "提交 prompt", "variant": "emphasis"}, {"from": "tui", "to": "server", "y": 212, "label": "启动会话执行", "variant": "default"}, {"from": "server", "to": "plugin", "y": 250, "label": "session.execution.started", "variant": "emphasis", "note": "重置轮次状态:starts[ses]=now,rates[ses]=新建"}, {"from": "provider", "to": "server", "y": 316, "label": "流式输出块 ×N", "variant": "default"}, {"from": "server", "to": "plugin", "y": 352, "label": "session.text/reasoning/tool.input.delta ×N", "variant": "emphasis", "note": "est += estimateTokens(delta),pushSample() 写入 10s 滑动窗口"}, {"from": "server", "to": "plugin", "y": 392, "label": "session.step.ended (tokens.output)", "variant": "default", "note": "精确值 > 当前估算时采纳:exact=out, refEst=est"}, {"from": "tui", "to": "plugin", "y": 446, "label": "footer render(sessionID),500ms tick", "variant": "default"}, {"from": "plugin", "to": "tui", "y": 478, "label": "⏱ waited …   ⚡ xx tok/s", "variant": "return"}, {"from": "server", "to": "plugin", "y": 508, "label": "session.execution.succeeded", "variant": "emphasis", "note": "结算:lastAvg = turnTotal / 轮次时长"}, {"from": "tui", "to": "user", "y": 536, "la